// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Source {
  LINKEDIN
  WELLFOUND
  EMAIL
  COMPANY_PORTAL
  REFERRAL
  OTHER
}

enum AppStatus {
  WISHLIST
  APPLIED
  OA
  PHONE
  TECHNICAL
  FINAL
  OFFER
  REJECTED
  GHOSTED
  WITHDRAWN
}

enum EventType {
  OA_DEADLINE
  PHONE_SCREEN
  TECHNICAL_INTERVIEW
  SYSTEM_DESIGN
  FINAL_ROUND
  HR_ROUND
  OFFER_DEADLINE
  FOLLOWUP_DUE
  OTHER
}

model User {
  id              String        @id @default(cuid())
  email           String        @unique
  name            String?
  emailVerified   DateTime?
  image           String?
  resumeText      String?
  gmailConnected  Boolean       @default(false)
  calendarId      String?
  createdAt       DateTime      @default(now())
  applications    Application[]
  accounts        Account[]
  sessions        Session[]
}

model Application {
  id                String          @id @default(cuid())
  userId            String
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  company           String
  role              String
  jobUrl            String?
  jobDescription    String?
  source            Source
  status            AppStatus       @default(APPLIED)

  recruiterName     String?
  recruiterEmail    String?
  recruiterLinkedIn String?

  salaryMin         Int?
  salaryMax         Int?
  currency          String          @default("INR")
  equity            String?

  appliedAt         DateTime?
  resumeVersion     String?
  coverLetter       Boolean         @default(false)
  referral          Boolean         @default(false)
  referralName      String?
  notes             String?
  tags              String[]

  matchScore        Int?
  aiNotes           String?

  gmailThreadId     String?
  calendarEventId   String?

  boardOrder        Int             @default(0)

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  events            Event[]
  statusHistory     StatusHistory[]
  emails            EmailThread[]

  @@index([userId, status])
  @@index([userId, createdAt])
}

model Event {
  id              String      @id @default(cuid())
  applicationId   String
  application     Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  type            EventType
  title           String
  scheduledAt     DateTime
  durationMins    Int?
  location        String?
  notes           String?
  completed       Boolean     @default(false)
  calendarEventId String?

  createdAt       DateTime    @default(now())

  @@index([applicationId])
  @@index([scheduledAt])
}

model StatusHistory {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  fromStatus    AppStatus?
  toStatus      AppStatus
  changedAt     DateTime    @default(now())
  note          String?
}

model EmailThread {
  id              String      @id @default(cuid())
  applicationId   String
  application     Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  gmailThreadId   String
  subject         String
  snippet         String?
  lastMessageAt   DateTime
  messageCount    Int         @default(1)
  fromEmail       String?
  createdAt       DateTime    @default(now())
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
